[Unit]
Description=Optihus miljøstyring (TCP-klient til Pi 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
#
# Typisk samme clone som ~/Optihus — binary fx build/miljoestyring/miljoestyring.
# Klient-server og port står i kildekoden shared/constants.hpp (kDefaultDataServerHost, kTcpPort).
ExecStart=/home/pi/Optihus/build/miljoestyring/miljoestyring
WorkingDirectory=/home/pi/Optihus
#
# Alternativ: dedikeret mappe med kun binary:
# ExecStart=/opt/optihus/miljoestyring/miljoestyring
# WorkingDirectory=/opt/optihus/miljoestyring
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
