[Unit]
Description=Optihus datahåndtering (TCP + Web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ret til DIN bruger på Pi (fx pi eller au756666). Brugeren skal kunne skrive til SQLite-filen nedenunder.
User=pi
Group=pi
#
# --- Typisk layout: clone og build som i ~/Optihus ---
# Den eksekverbare fra din tree: build/datahaandtering/datahaandtering
# WorkingDirectory SKAL være repo-roden (.), så "sql/init.sql" findes (se datahaandtering/main.cpp).
ExecStart=/home/pi/Optihus/build/datahaandtering/datahaandtering
WorkingDirectory=/home/pi/Optihus
#
# --- Alternativ: binary under /opt (kopier evt. sql/ eller brug eksisterende DB) ---
# ExecStart=/opt/optihus/bin/datahaandtering
# WorkingDirectory=/opt/optihus/repo
Restart=on-failure
RestartSec=5

# SQLite-sti er hardkodet i koden: /opt/optihus/data/optihus.db
# Opret mappe og fil med korrekt ejer, eller systemd fejler ved open():

[Install]
WantedBy=multi-user.target
