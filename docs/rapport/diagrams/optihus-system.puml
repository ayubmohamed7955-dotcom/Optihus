  [MessageEnvelope]
  [MessageCodec]
}

Konfig --> Proto : set_config
Proto --> Felt
Felt --> Proto : telemetry
Proto --> Historik
Konfig ..> Historik : Web-ui / TUI

note right of Konfig
  DB håndhæver **≤1 aktiv** plant_boxes\n(via repair i DatabaseManager)
end note

note right of Felt
  Jord i Profile bruges **ikke** til pumpe i v1;\n**plant_boxes**-JSON styrer PlantBox.
end note

@enduml


@startuml optihus-er
title Domæne — ER-diagram (SQLite, felter fra sql/init.sql)
skinparam linetype ortho
skinparam shadowing false

entity "telemetry" as tel {
  * id : INTEGER <<PK AI>>
  --
  timestamp : TEXT <<NOT NULL>>
  temperature_c : REAL
  humidity_air : REAL
  humidity_soil : REAL
  pump_status : TEXT <<NOT NULL>>
  motor_status : TEXT <<NOT NULL>>
  error_status : TEXT <<NOT NULL def 'none'>>
  source : TEXT <<NOT NULL def miljoestyring>>
}

entity "profiles" as prof {
  * id : INTEGER <<PK AI>>
  --
  name : TEXT <<UK NOT NULL>>
  crop_type : TEXT <<NOT NULL>>
  min_humidity_air : REAL <<NOT NULL>>
  max_humidity_air : REAL <<NOT NULL>>
  min_humidity_soil : REAL <<NOT NULL>>
  max_humidity_soil : REAL <<NOT NULL>>
  interval_sec : INTEGER <<NOT NULL>>
  is_default : INTEGER <<NOT NULL>>
  created_at : TEXT <<NOT NULL>>
  updated_at : TEXT <<NOT NULL>>
}

entity "active_config" as ac {
  * id : INTEGER <<PK CHECK id=1>>
  --
  timestamp : TEXT <<NOT NULL>>
  mode : TEXT <<NOT NULL>>
  profile_name : TEXT <<NOT NULL>>
  interval_sec : INTEGER <<NOT NULL>>
  emergency_stop : INTEGER <<NOT NULL>>
}

entity "plant_boxes" as pb {
  * id : INTEGER <<PK AI>>
  --
  label : TEXT <<NOT NULL>>
  slot : INTEGER <<UK NOT NULL>>
  is_active : INTEGER <<NOT NULL>>
  min_soil_pct : REAL <<NOT NULL>>
  max_soil_pct : REAL <<NOT NULL>>
  pump_duration_sec : INTEGER <<NOT NULL>>
  hysteresis_sec : INTEGER <<NOT NULL>>
  created_at : TEXT <<NOT NULL>>
  updated_at : TEXT <<NOT NULL>>
}

entity "system_events" as ev {
  * id : INTEGER <<PK AI>>
  --
  timestamp : TEXT <<NOT NULL>>
  event_type : TEXT <<NOT NULL>>
  description : TEXT <<NOT NULL>>
  severity : TEXT <<NOT NULL>>
}

entity "command_history" as ch {
  * id : INTEGER <<PK AI>>
  --
  timestamp : TEXT <<NOT NULL>>
  action : TEXT <<NOT NULL>>
  payload_json : TEXT
  source : TEXT <<NOT NULL>>
  status : TEXT <<NOT NULL>>
}

ac .. prof : **logisk:** profile_name\n→ profiles.name\n(ingen FK i SQL)

note as N2
  Ingen FOREIGN KEY mellem tabeller\ni init.sql (kun PRAGMA foreign_keys).
  Merge af profiler til **bounds** sker på server ved **set_config**.
end note

@enduml


@startuml optihus-sequence-handshake
title Sekvens — Hello, set_config og telemetri
autonumber
skinparam shadowing false

participant "Pi 2\nmiljoestyring" as P2
participant "TCP server" as TCP
participant "datahaandtering::App" as APP
participant "CommandDispatcher" as DIS
database "SQLite" as DB
participant "TelemetryProcessor" as TP
participant "Web-ui" as WEB

P2 -> TCP : TCP connect
P2 -> APP : Hello (via inbound_queue)
APP -> DIS : dispatch_current_config()
DIS -> DB : læs aktiv config,\nprofiler, plant_boxes
DIS -> TCP : Command **set_config**\n(ud af outbound_queue)
P2 <- TCP : set_config

loop hvert telemetry_interval_sec (fra set_config / default)
  P2 -> APP : telemetry\n(+ field_live → WEB)
  APP -> TP : telemetry_queue
  TP -> DB : insert_telemetry
  TP -> WEB : note_field_live
end

WEB -> APP : gem konfig (HTTP)
APP -> DB : persist
APP -> DIS : push config til felt
DIS -> P2 : set_config

@enduml


@startuml optihus-sequence-reconnect
title Sekvens — nettab og genforbindelse (Pi 2)
autonumber
skinparam shadowing false

participant "Pi 2\nmiljoestyring::App" as P2
participant "Pi 1" as P1

note over P2 : TcpClient mister socket /\nlæser-thread stopper

loop hvert kReconnectDelaySec (3 s)
  P2 -> P1 : connect() retry
end

opt Linux
  P2 -> P2 : nmcli wifi on +\nwifi rescan\n(hver 3. fejlslagen connect)
end

P2 -> P1 : Hello (efter connect)
P1 -> P2 : set_config (som ved første Hello)

@enduml


@startuml optihus-control-path
