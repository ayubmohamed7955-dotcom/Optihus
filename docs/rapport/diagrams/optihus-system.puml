  GF ..> DB : read-only
  TUI ..> DB : direkte (uden HTTP)
}

@enduml


@startuml optihus-state-motor
title Tilstand — Motor / vindue (Pi 2, konceptuel)
skinparam shadowing false

[*] --> Maaler : ~kSensorIntervalSec (2 s)\n+ DHT update (IIO)
Maaler --> Evaluer : temp + luftfugt
Evaluer --> Luk : under min temp **eller**\nunder min luftfugt
Evaluer --> Aab : over max temp **eller**\nover max luftfugt
Evaluer --> Hold : ellers (hysterese via\nshouldOpen latch)
Luk --> StepMotor : close / open\n(se runSteps)
Aab --> StepMotor
Hold --> Maaler
StepMotor --> Maaler

note right of Evaluer
  **set_config:** temp_bounds_c,\nbounds.min/max_humidity_air
end note

@enduml


@startuml optihus-state-plantbox
title Tilstand — PlantBox / vanding (Pi 2, konceptuel)
skinparam shadowing false

[*] --> Idle
Idle --> Maal : 5× ADC sample / 1s
Maal --> Vurder : gennemsnit %\njordfugt
Vurder --> Pump : avg **≤** min **og**\navg **<** max_skip **og**\nhysterese udløbet
Vurder --> Idle : ingen vanding
Pump --> Idle : efter pump_duration_sec

note right of Idle
  **evaluate_plant_watering:**\n0 aktive / >1 aktiv plant_boxes\n→ ingen vanding (fail-safe)
end note

@enduml


@startuml optihus-deployment
title Deployment — Pi 1 + Pi 2 (eksempler)
skinparam componentStyle rectangle
skinparam shadowing false

node "Pi 1\n(datahaandtering-rpi)" as N1 {
  component "NetworkManager\n(AP / hotspot)\nOptihusNet" as NM1
  component "systemd unit\n(se vejledning/systemd/*.example)" as SD1
  component "datahaandtering\nbinary" as EX1
  folder "WorkingDirectory\n(typisk repo-rod\nfor sql/init.sql)" as WD1
  database "/opt/optihus/data/optihus.db\n(kDbPath)" as DBF
  NM1 -[hidden]-> EX1
  SD1 --> EX1
  EX1 --> WD1
  EX1 --> DBF
}

node "Pi 2\n(miljoestyring-rpi)" as N2 {
  component "WiFi klient" as NM2
  component "systemd unit\n(se vejledning/systemd)" as SD2
  component "miljoestyring\nbinary" as EX2
  NM2 --> EX2
  SD2 --> EX2
}

actor "Browser" as LAP
LAP --> EX1 : typisk **192.168.4.1:8080**
EX2 --> EX1 : **192.168.4.1:5000**\n(standard på AP)

@enduml


@startuml optihus-layers
title Lagdelt arkitektur
skinparam packageStyle rectangle
skinparam shadowing false

together {
  package "Lag 1: Mennesker & observabilitet" {
    [Browser :8080]
    [Grafana read-only]
    [TUI --tui]
  }
  package "Lag 2: Pi 1 — logik + persistens" {
    [datahaandtering + SQLite]
  }
  package "Lag 3: Pi 2 — feltnode" {
    [miljoestyring + optihus_shared]
  }
  package "Lag 4: Fysisk" {
    [IIO DHT, gpiod stepper,\nI2C jord, pumpe GPIO]
  }
}

@enduml
