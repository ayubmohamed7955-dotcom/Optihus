# Optihus — Pi 2 (miljøstyring, klient mod Pi 1)
#
# FØR du kopierer til /etc/systemd/system/:
#   Erstat ALLE forekomster af __RPI2_LINUX_BRUGERNAVN__ med output af whoami på denne Pi.
#
# Klient mål‑server og TCP‑port samles fra shared/constants.hpp (kDefaultDataServerHost, kTcpPort).
#
[Unit]
Description=Optihus miljøstyring (Pi 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RPI2_LINUX_BRUGERNAVN__
Group=__RPI2_LINUX_BRUGERNAVN__
ExecStart=/home/__RPI2_LINUX_BRUGERNAVN__/Optihus/build/miljoestyring/miljoestyring
WorkingDirectory=/home/__RPI2_LINUX_BRUGERNAVN__/Optihus
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
