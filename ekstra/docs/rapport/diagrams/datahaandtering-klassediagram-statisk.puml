@startuml
title Use Case 1 - Klassediagram (Tilfoej graensevaerdier)
skinparam shadowing false
skinparam classAttributeIconSize 0

class WebUiServer <<boundary>> {
  + handle_config_request(...)
  + handle_profiles_request(...)
  + handle_plant_boxes_request(...)
}

class ConfigManager <<control>> {
  + load_active_config() : bool
  + save_active_config() : bool
  + current_config() : ActiveConfig
}

class DatabaseManager <<control>> {
  + list_profiles() : vector<Profile>
  + upsert_profile(...) : bool
  + list_plant_boxes() : vector<PlantBoxConfig>
  + upsert_plant_box(...) : bool
  + save_active_config(...) : bool
}

class ActiveConfig <<domain>>
class Profile <<domain>>
class PlantBoxConfig <<domain>>

WebUiServer --> ConfigManager
WebUiServer --> DatabaseManager
ConfigManager --> ActiveConfig
DatabaseManager --> Profile
DatabaseManager --> PlantBoxConfig

@enduml
